# CEDC Expo — environment variables
# Copy to `.env.local` and fill in values. Never commit real secrets.
# NEVER put real keys in this example file.

# -----------------------------------------------------------------------------
# PUBLIC (safe in the browser — gated by Supabase RLS)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Dashboard may label this "anon" (legacy JWT) OR "publishable" (sb_...).
# Prefer this name; PUBLISHABLE_KEY is also accepted by the app as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: extra hosts for phone-on-LAN Next.js HMR (comma-separated)
# ALLOWED_DEV_ORIGINS=192.168.1.20,10.0.0.5

# For phone / other-device QR links, set your Mac LAN IP (not localhost):
# NEXT_PUBLIC_APP_URL=http://192.168.x.x:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: expo-day rate limits (defaults are venue-friendly for ~50 judges)
# Shared Wi‑Fi uses one public IP, so login IP limit is high; per-username stays tight.
# LOGIN_RATE_LIMIT_MAX=80
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# LOGIN_USERNAME_RATE_LIMIT_MAX=8
# EVAL_MUTATION_RATE_LIMIT_MAX=120

# -----------------------------------------------------------------------------
# SECRET (server-only — NEVER prefix with NEXT_PUBLIC_)
# Never import into Client Components or ship in the PWA cache.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# See .planning/AUTH_SETUP.md for creating admin/judge users after migrations.
